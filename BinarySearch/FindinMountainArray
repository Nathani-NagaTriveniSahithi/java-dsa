class Solution{
    public int findInMountainArray(int target, MountainArray mountainArr) {
        int start = 0;
        int end = mountainArr.length() - 1;
        int peak = findpeakelement(mountainArr);
        int leftsearch = binarysearch(mountainArr,target,0,peak);
        int rightsearch = -1;
        if(leftsearch != -1)
            return leftsearch;
        return binarysearch(mountainArr,target,peak + 1,mountainArr.length() - 1);
    }
    int binarysearch(MountainArray mountainArr,int target,int start,int peak){
        boolean isAsc = mountainArr.get(start) < mountainArr.get(peak);
        while(start <= peak){
            int mid = start + (peak - start) / 2;
            if(mountainArr.get(mid) == target){
                return mid;
            }
            if(isAsc){
                if(target < mountainArr.get(mid))
                    peak = mid - 1;
                else
                    start = mid + 1;
            }
            else{
                if(target < mountainArr.get(mid))
                    start = mid + 1;
                else
                    peak = mid - 1;
            }
        }
        return -1;
    }
    int findpeakelement(MountainArray mountainArr){
        int start = 0;
        int end = mountainArr.length() - 1;
        /*if you not understand refer to the question find peak element in mountain array because both are same*/
        while(start <= end){
            int mid = start + (end - start) / 2;
            if(start == end)
                return start;
            else if(mountainArr.get(mid) > mountainArr.get(mid + 1))
                end = mid;
            else
                start = mid + 1;
        }
        return 0;
    }
}