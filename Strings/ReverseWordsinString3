class Solution {
    public String reverseWords(String s) {
        String rev = "";
        int k = 0;
        for(int i = 0;i < s.length();i++){
            if(s.charAt(i) == ' '){
                for(int j = i - 1;j >= k;j--){
                    rev = rev + s.charAt(j);
                }
                rev = rev + " ";
                k = i + 1;
            }
        }
        for(int l = s.length() - 1;l >= k;l--)
            rev = rev + s.charAt(l);
        return rev;
    }
}