class Solution {
    public boolean isPalindrome(String s) {
        boolean palindrome = true;
        if(s == null)
            return palindrome;
        s = s.toLowerCase();
        s = s.replaceAll("[^a-zA-Z0-9]","");
        for(int i = 0;i <  s.length() / 2;i++){
            char start = s.charAt(i);
            char end = s.charAt(s.length() - i - 1);
            if(start != end)
                return false;
        }
        return true;
        
    }
}